rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isPartyMember(partyId) {
      return isAuthenticated() && 
        request.auth.uid in get(/databases/$(database)/documents/parties/$(partyId)).data.members;
    }

    function isHost() {
      return isAuthenticated() && request.auth.uid == resource.data.hostUserId;
    }

    function mediaKeyUnchanged() {
      return !('mediaKey' in resource.data) ||
        request.resource.data.mediaKey == resource.data.mediaKey;
    }

    function hostUserIdUnchanged() {
      return request.resource.data.hostUserId == resource.data.hostUserId;
    }

    function membersUnchanged() {
      return request.resource.data.members == resource.data.members;
    }
    
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    match /parties/{partyId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.members;
      allow create: if isAuthenticated()
        && request.resource.data.hostUserId == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.isActive == true
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      // Membership and leave/join go through Admin SDK Cloud Functions.
      // Clients may only set mediaKey if missing, or deactivate the party.
      allow update: if isHost()
        && mediaKeyUnchanged()
        && hostUserIdUnchanged()
        && membersUnchanged();
      allow delete: if isHost();
      
      match /members/{userId} {
        allow read, write: if isPartyMember(partyId);
      }
      
      match /media/{mediaId} {
        allow read: if isPartyMember(partyId);
        allow create: if isPartyMember(partyId)
          && request.resource.data.partyId == partyId
          && request.resource.data.id == mediaId
          && request.resource.data.userId == request.auth.uid;
        allow update: if isPartyMember(partyId)
          && request.resource.data.partyId == resource.data.partyId
          && request.resource.data.id == resource.data.id
          && request.resource.data.userId == resource.data.userId;
        allow delete: if isPartyMember(partyId) && (
          request.auth.uid == resource.data.userId ||
          get(/databases/$(database)/documents/parties/$(partyId)).data.hostUserId == request.auth.uid
        );
      }
    }
  }
}
